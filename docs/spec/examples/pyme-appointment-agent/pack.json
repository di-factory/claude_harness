{
  "$schema": "https://di-factory.biz/schemas/solution-spec.v1.json",
  "spec_version": "1",
  "kind": "pack",
  "solution": {
    "id": "pyme-appointment-agent",
    "version": "1.0.2",
    "name": "Appointment Agent",
    "lob": "pyme",
    "description": "Confirms, reminds and reschedules appointments for clinics and practices over WhatsApp/SMS.",
    "locale": "en"
  },
  "variables": {
    "business_name": {
      "type": "string",
      "required": true,
      "description": "Name shown to patients",
      "ask": {
        "question": "What is the business name patients should see?",
        "example": "Clínica Dental Luna",
        "answered_by": "client",
        "group": "scheduling",
        "order": 1
      }
    },
    "business_hours": {
      "type": "schedule",
      "required": true,
      "description": "Opening hours per weekday",
      "ask": {
        "question": "What are the opening hours for each weekday?",
        "example": "mon-fri: 09:00-19:00; sat: 09:00-14:00",
        "answered_by": "client",
        "group": "scheduling",
        "order": 2
      }
    },
    "whatsapp_number": {
      "type": "string",
      "required": true,
      "description": "Client-owned sender number",
      "ask": {
        "question": "Which WhatsApp number (in the client's own gateway account) sends the messages?",
        "example": "+525512345678",
        "answered_by": "client",
        "group": "channels",
        "order": 1
      }
    },
    "calendar_ids": {
      "type": "list",
      "required": true,
      "description": "Google Calendar id per practitioner",
      "ask": {
        "question": "Which Google Calendar belongs to each practitioner?",
        "example": "dra-luna@clinicaluna.mx, dr-perez@clinicaluna.mx",
        "answered_by": "client",
        "group": "integrations",
        "order": 1
      }
    },
    "reminder_hours": {
      "type": "integer",
      "default": 24,
      "min": 1,
      "max": 72,
      "ask": {
        "question": "How many hours before an appointment should patients be reminded?",
        "answered_by": "client",
        "group": "scheduling",
        "order": 3
      }
    },
    "tpl_reminder_id": {
      "type": "string",
      "required": true,
      "description": "Approved WhatsApp template id for reminders",
      "ask": {
        "question": "What is the approved WhatsApp template id for reminders?",
        "example": "HXb5b62575e6e4ff6129ad7c8efe1f983e",
        "answered_by": "difactory",
        "group": "channels",
        "order": 2
      }
    },
    "tpl_nudge_id": {
      "type": "string",
      "required": true,
      "description": "Approved WhatsApp template id for the follow-up nudge",
      "ask": {
        "question": "What is the approved WhatsApp template id for the follow-up nudge?",
        "example": "HX0e8c1c6f2b1f4e8a9a6d7c3b2a1f0e9d",
        "answered_by": "difactory",
        "group": "channels",
        "order": 3
      }
    },
    "ops_email": {
      "type": "string",
      "required": true,
      "description": "Where approvals and escalations are notified",
      "ask": {
        "question": "Which email should receive approvals and escalations?",
        "example": "recepcion@clinicaluna.mx",
        "answered_by": "client",
        "group": "operations",
        "order": 1
      }
    },
    "main_model": {
      "type": "string",
      "default": "<main-model-id>",
      "ask": {
        "question": "Which model should the main agent use?",
        "answered_by": "difactory",
        "group": "models",
        "order": 1
      }
    },
    "fast_model": {
      "type": "string",
      "default": "<fast-model-id>",
      "ask": {
        "question": "Which low-cost model should handle routing and summaries?",
        "answered_by": "difactory",
        "group": "models",
        "order": 2
      }
    }
  },
  "secrets": {
    "anthropic": {
      "description": "Model API key"
    },
    "twilio": {
      "description": "Messaging gateway credentials (client-owned account)"
    },
    "google": {
      "description": "Google Calendar service account"
    }
  },
  "models": {
    "roles": {
      "main": {
        "provider": "anthropic",
        "model": "{{var.main_model}}",
        "effort": "medium"
      },
      "router": {
        "provider": "anthropic",
        "model": "{{var.fast_model}}",
        "effort": "low"
      },
      "verifier": {
        "provider": "anthropic",
        "model": "{{var.fast_model}}",
        "effort": "medium"
      },
      "compaction": {
        "provider": "anthropic",
        "model": "{{var.fast_model}}",
        "effort": "low"
      },
      "memory_extraction": {
        "provider": "anthropic",
        "model": "{{var.fast_model}}",
        "effort": "low"
      }
    },
    "providers": {
      "anthropic": {
        "api_key": {
          "$secret": "anthropic"
        },
        "via": "direct"
      }
    }
  },
  "agents": {
    "receptionist": {
      "description": "Talks with patients: confirms, reschedules and cancels appointments; answers FAQ.",
      "prompt": "prompts/receptionist.md",
      "model_role": "main",
      "tools": [
        "calendar.find_slots",
        "calendar.get_event",
        "calendar.move_event",
        "calendar.cancel_event",
        "calendar.check_conflicts",
        "slots.best_slot",
        "knowledge.search_clinic_faq"
      ],
      "knowledge": [
        "clinic_faq"
      ],
      "memory": {
        "scope": "contact"
      },
      "handoffs": [
        "human"
      ],
      "max_turns": 12
    }
  },
  "tools": {
    "packs": [
      "connectors/google-calendar"
    ],
    "python": [
      "extensions.slots:best_slot"
    ],
    "config": {
      "connectors/google-calendar": {
        "credentials": {
          "$secret": "google"
        },
        "calendar_ids": "{{var.calendar_ids}}",
        "business_hours": "{{var.business_hours}}"
      }
    },
    "overrides": {
      "calendar.move_event": {
        "verify": "no-double-booking"
      },
      "calendar.delete_event": {
        "permission": "deny"
      }
    }
  },
  "knowledge": {
    "corpora": {
      "clinic_faq": {
        "sources": [
          {
            "type": "file",
            "path": "knowledge/faq.md"
          }
        ],
        "questionnaire": [
          { "id": "about", "heading": "What is the clinic about?", "required": true,
            "question": "What does the clinic do? Two or three sentences a patient would understand.",
            "example": "A family dental clinic in Coyoacán with 3 dentists, open since 2012." },
          { "id": "services", "heading": "Which services do you offer?", "required": true,
            "question": "Which services do you offer, and roughly how long does each take?",
            "example": "Cleaning (45 min), fillings (1 h), extractions, orthodontics, whitening." },
          { "id": "prices", "heading": "How much do services cost?",
            "question": "Prices you are happy to share by chat (or 'only in person').",
            "example": "Cleaning $600 MXN; first consultation free." },
          { "id": "location", "heading": "Where are you located?", "required": true,
            "question": "Address, how to get there and parking.",
            "example": "Av. Universidad 123, Col. Del Valle, CDMX. Parking in front." },
          { "id": "payment", "heading": "Which payment methods do you accept?",
            "question": "Payment methods, insurance and installments.",
            "example": "Cash, debit and credit cards; 6 months without interest on orthodontics." },
          { "id": "policies", "heading": "What is your cancellation policy?",
            "question": "Cancellation, lateness and rescheduling rules.",
            "example": "Cancel up to 24 h before at no cost; after 15 min late we reschedule." },
          { "id": "emergencies", "heading": "What should I do in an emergency?",
            "question": "What should a patient with an emergency do (phone, hours, nearest service)?",
            "example": "Call 55 1234 5678; outside hours go to the nearest emergency room." }
        ],
        "chunking": "layout",
        "retrieval": {
          "mode": "hybrid",
          "top_k": 4,
          "min_score": 0.35,
          "read_whole_below": 12000,
          "cite": false,
          "not_found": "handoff"
        }
      }
    }
  },
  "memory": {
    "layers": [
      "episodic",
      "semantic"
    ],
    "scope": "contact",
    "episodic_ttl": "90d"
  },
  "channels": {
    "whatsapp": {
      "type": "gateway",
      "provider": "twilio",
      "credentials": {
        "$secret": "twilio"
      },
      "address": "{{var.whatsapp_number}}",
      "entry_agent": "receptionist",
      "contact_key": "phone",
      "session_window": "24h",
      "templates": {
        "reminder": {
          "file": "prompts/tpl_reminder.md",
          "provider_template_id": "{{var.tpl_reminder_id}}"
        },
        "reminder_nudge": {
          "file": "prompts/tpl_nudge.md",
          "provider_template_id": "{{var.tpl_nudge_id}}"
        }
      }
    },
    "web": {
      "type": "web",
      "public": true,
      "entry_agent": "receptionist",
      "session_window": "24h"
    }
  },
  "triggers": {
    "reminder": {
      "type": "relative",
      "source": "calendar.events",
      "offset": "-{{var.reminder_hours}}h",
      "workflow": "send-reminder",
      "requires_consent": true
    }
  },
  "workflows": {
    "send-reminder": {
      "input": {
        "event": "calendar.event"
      },
      "steps": [
        {
          "id": "msg",
          "type": "template",
          "channel": "whatsapp",
          "template": "reminder",
          "to": "{{event.contact}}"
        },
        {
          "id": "wait",
          "type": "wait",
          "for": "reply",
          "timeout": "12h"
        },
        {
          "id": "handle",
          "type": "agent",
          "agent": "receptionist",
          "input": "{{steps.wait.reply}}",
          "when": "steps.wait.replied"
        },
        {
          "id": "nudge",
          "type": "template",
          "channel": "whatsapp",
          "template": "reminder_nudge",
          "to": "{{event.contact}}",
          "when": "not steps.wait.replied"
        }
      ],
      "on_error": "escalate"
    }
  },
  "policies": {
    "profile": "strict",
    "permissions": {
      "allow": [
        "calendar.find_slots",
        "calendar.get_event",
        "calendar.check_conflicts",
        "slots.best_slot",
        "knowledge.*"
      ],
      "ask": [
        "calendar.cancel_event"
      ],
      "deny": [
        "calendar.delete_event"
      ]
    },
    "budgets": {
      "per_run": {
        "usd": 0.2,
        "turns": 12
      },
      "per_tenant_day": {
        "usd": 5
      }
    },
    "verification": {
      "checks": {
        "no-double-booking": {
          "type": "tool",
          "tool": "calendar.check_conflicts",
          "expect": "no_conflicts"
        }
      },
      "verifier": {
        "model_role": "verifier",
        "applies_to": [
          "effect:external"
        ],
        "mode": "critical_only"
      }
    },
    "escalation": {
      "rules": [
        {
          "when": "intent in ['medical_advice', 'complaint', 'emergency']",
          "to": "human"
        },
        {
          "when": "verification.failed_twice",
          "to": "human"
        }
      ],
      "handoff_to": {
        "type": "inbox"
      }
    },
    "router": {
      "short_circuit": [
        "greeting",
        "hours",
        "address"
      ],
      "model_role": "router"
    }
  },
  "governance": {
    "pii": {
      "classes": [
        "name",
        "phone",
        "email",
        "curp",
        "health"
      ],
      "tokenize": true,
      "reveal_in_output": [
        "name"
      ]
    },
    "consent": {
      "required": true,
      "channels": [
        "whatsapp"
      ],
      "opt_out_keywords": [
        "BAJA",
        "STOP",
        "ALTO"
      ]
    },
    "retention": {
      "conversations": "180d",
      "episodic": "90d",
      "audit": "5y"
    },
    "audit": {
      "level": "full"
    },
    "regions": {
      "data": "mx",
      "models": [
        "us",
        "mx"
      ]
    },
    "compliance": [
      "lfpdppp"
    ]
  },
  "hitl": {
    "approvers": [
      "role:front_desk"
    ],
    "notify": [
      {
        "channel": "email",
        "to": "{{var.ops_email}}"
      }
    ],
    "approval_timeout": "2h",
    "on_timeout": "reject"
  },
  "evals": {
    "suites": [
      "evals/confirm.yaml",
      "evals/reschedule.yaml",
      "evals/opt_out.yaml",
      "evals/pii.yaml"
    ],
    "thresholds": {
      "pass_rate": 0.9,
      "unsafe_actions": 0
    }
  }
}
