{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extracted invoice",
  "type": "object",
  "required": ["uuid", "rfc_emisor", "rfc_receptor", "date", "total", "currency", "confidence"],
  "properties": {
    "uuid": { "type": "string", "description": "CFDI fiscal folio (UUID)" },
    "rfc_emisor": { "type": "string" },
    "rfc_receptor": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "subtotal": { "type": "number" },
    "taxes": { "type": "number" },
    "total": { "type": "number" },
    "currency": { "type": "string", "enum": ["MXN", "USD", "EUR"] },
    "line_items": { "type": "array", "items": { "type": "object", "properties": { "description": { "type": "string" }, "amount": { "type": "number" } } } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
