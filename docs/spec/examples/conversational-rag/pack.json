{
  "$schema": "https://di-factory.biz/schemas/solution-spec.v1.json",
  "spec_version": "1",
  "kind": "pack",
  "solution": {
    "id": "conversational-rag",
    "version": "1.0.0",
    "name": "Conversational RAG Assistant",
    "lob": "agentic-transformation",
    "description": "Answers questions from the client's documents with citations over Telegram, web and email; says so when the answer is not in the corpus.",
    "locale": "en"
  },
  "variables": {
    "assistant_name": {
      "type": "string",
      "required": true,
      "ask": {
        "question": "What should the assistant be called?",
        "example": "Reparo",
        "answered_by": "client"
      }
    },
    "corpus_sources": {
      "type": "list",
      "required": true,
      "description": "Knowledge sources (files, Drive folders, S3 prefixes)",
      "ask": {
        "question": "Where are the documents it answers from? A whole web site (https://site.com/*: the setup reads every page and writes the knowledge file from it), single web pages (https://...), files or folders on this server (relative to the client's folder), Drive folders (gdrive://<folder id>) or S3 (s3://bucket/prefix); several: separate with commas.",
        "example": "https://reparo.mx/*, manual.pdf",
        "answered_by": "client"
      }
    },
    "telegram_enabled": {
      "type": "boolean",
      "default": true
    },
    "support_email": {
      "type": "string",
      "required": true,
      "description": "Where unanswered questions are escalated",
      "ask": {
        "question": "Which email gets the questions the documents do not answer?",
        "example": "soporte@reparo.mx",
        "answered_by": "client"
      }
    },
    "llm_base_url": {
      "type": "string",
      "default": "https://api.openai.com/v1",
      "description": "Any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, gateway)"
    },
    "main_model": {
      "type": "string",
      "default": "<main-model-id>"
    },
    "fast_model": {
      "type": "string",
      "default": "<fast-model-id>"
    }
  },
  "secrets": {
    "llm": {
      "description": "Key for the OpenAI-compatible endpoint"
    },
    "telegram": {
      "description": "Telegram bot token"
    },
    "email": {
      "description": "SMTP/IMAP credentials"
    },
    "sources": {
      "description": "Read access to the knowledge sources"
    }
  },
  "models": {
    "roles": {
      "main": {
        "provider": "openai-compatible",
        "model": "{{var.main_model}}",
        "effort": "medium"
      },
      "router": {
        "provider": "openai-compatible",
        "model": "{{var.fast_model}}",
        "effort": "low"
      },
      "verifier": {
        "provider": "openai-compatible",
        "model": "{{var.fast_model}}",
        "effort": "medium"
      },
      "compaction": {
        "provider": "openai-compatible",
        "model": "{{var.fast_model}}",
        "effort": "low"
      }
    },
    "providers": {
      "openai-compatible": {
        "base_url": "{{var.llm_base_url}}",
        "api_key": {
          "$secret": "llm"
        }
      }
    }
  },
  "agents": {
    "assistant": {
      "description": "Answers only from the corpus, with citations.",
      "prompt": "prompts/assistant.md",
      "model_role": "main",
      "tools": [
        "knowledge.search_docs",
        "knowledge.search_about"
      ],
      "knowledge": [
        "docs",
        "about"
      ],
      "memory": {
        "scope": "contact"
      },
      "handoffs": [
        "human"
      ],
      "max_turns": 6
    }
  },
  "tools": {
    "packs": [],
    "overrides": {}
  },
  "knowledge": {
    "corpora": {
      "docs": {
        "sources": "{{var.corpus_sources}}",
        "auth": {
          "$secret": "sources"
        },
        "chunking": "layout",
        "retrieval": {
          "mode": "hybrid",
          "top_k": 8,
          "min_score": 0.45,
          "rerank": true,
          "cite": true,
          "not_found": "say_so"
        },
        "sync": {
          "schedule": "0 */4 * * *",
          "on_delete": "propagate"
        }
      },
      "about": {
        "description": "who the assistant answers for: what the organization does, what people can ask, how to reach a person",
        "sources": [
          {
            "type": "file",
            "path": "knowledge/about.md"
          }
        ],
        "questionnaire": [
          {
            "id": "about",
            "heading": "What is this about?",
            "required": true,
            "question": "What does the business or organization do? Two or three sentences a visitor would understand (it opens the web page).",
            "example": "Reparo fixes phones and laptops in Guadalajara; we answer questions about repairs, warranties and prices."
          },
          {
            "id": "topics",
            "heading": "What can I ask?",
            "required": true,
            "question": "What can people ask the assistant about? A short list.",
            "example": "Repair times, warranty terms, prices of common repairs, how to send a device."
          },
          {
            "id": "contact",
            "heading": "How do I reach a person?",
            "required": true,
            "question": "How can people reach a person: email, phone, address and hours.",
            "example": "soporte@reparo.mx, 33 1234 5678, Mon-Fri 9:00-18:00; Av. Vallarta 100, Guadalajara."
          }
        ],
        "chunking": "layout",
        "retrieval": {
          "mode": "hybrid",
          "top_k": 4,
          "min_score": 0.35,
          "read_whole_below": 12000,
          "cite": true,
          "not_found": "say_so"
        }
      }
    }
  },
  "memory": {
    "layers": [
      "episodic"
    ],
    "scope": "contact",
    "episodic_ttl": "30d"
  },
  "channels": {
    "telegram": {
      "type": "telegram",
      "credentials": {
        "$secret": "telegram"
      },
      "entry_agent": "assistant",
      "contact_key": "telegram_user_id",
      "enabled": "{{var.telegram_enabled}}"
    },
    "web": {
      "type": "web",
      "public": true,
      "entry_agent": "assistant",
      "contact_key": "session_cookie",
      "session_window": "24h"
    },
    "email": {
      "type": "email",
      "credentials": {
        "$secret": "email"
      },
      "entry_agent": "assistant",
      "contact_key": "email"
    }
  },
  "triggers": {},
  "workflows": {},
  "policies": {
    "profile": "default",
    "permissions": {
      "allow": [
        "knowledge.*"
      ],
      "ask": [],
      "deny": [
        "effect:external"
      ]
    },
    "budgets": {
      "per_run": {
        "usd": 0.05,
        "turns": 6
      },
      "per_tenant_day": {
        "usd": 10
      }
    },
    "verification": {
      "checks": {
        "grounded": {
          "type": "citations",
          "min_citations": 1,
          "claims_must_cite": true
        }
      },
      "verifier": {
        "model_role": "verifier",
        "applies_to": [
          "output"
        ],
        "mode": "sampled",
        "sample_rate": 0.2
      }
    },
    "escalation": {
      "rules": [
        {
          "when": "knowledge.not_found and contact.insists",
          "to": "human"
        },
        {
          "when": "intent in ['legal_advice', 'medical_advice', 'financial_advice']",
          "to": "human"
        }
      ],
      "handoff_to": {
        "type": "email",
        "to": "{{var.support_email}}"
      }
    },
    "router": {
      "short_circuit": [
        "greeting",
        "thanks",
        "who_are_you"
      ],
      "model_role": "router"
    }
  },
  "governance": {
    "pii": {
      "classes": [
        "name",
        "email",
        "phone",
        "rfc",
        "curp"
      ],
      "tokenize": true,
      "reveal_in_output": []
    },
    "consent": {
      "required": false
    },
    "retention": {
      "conversations": "90d",
      "episodic": "30d",
      "audit": "2y"
    },
    "audit": {
      "level": "standard"
    },
    "compliance": [
      "lfpdppp"
    ]
  },
  "hitl": {
    "notify": [
      {
        "channel": "email",
        "to": "{{var.support_email}}"
      }
    ]
  },
  "evals": {
    "suites": [
      "evals/answerable.yaml",
      "evals/not_found.yaml",
      "evals/citations.yaml",
      "evals/pii.yaml"
    ],
    "thresholds": {
      "pass_rate": 0.9,
      "unsafe_actions": 0,
      "citation_rate": 0.95
    }
  }
}
